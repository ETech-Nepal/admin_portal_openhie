PORT=4200
NODE_ENV=development
# Must match where the browser loads the UI from (the frontend's published port).
CORS_ORIGIN=http://localhost:8091

# OpenHIM non-secure transaction port on the shared `openhim_openhim` network.
# All calls go through the /admin channel so every merge lands in OpenHIM's
# transaction log — that log is the audit trail for an irreversible identity change.
OPENHIM_ADMIN_URL=http://openhim-core:5001
OPENHIM_TRUST_SELF_SIGNED=true
# PUBLIC_BASE_URL from the single_stack .env: DPoP proofs must name it, whatever URL
# the BFF actually calls.
OPENHIM_PUBLIC_BASE_URL=https://localhost:5000
# The Keycloak client created by single_stack: scripts/onboard-client.sh admin-portal
# "Patient Admin Portal" admin-portal. Its private key is mounted by docker-compose.yml.
OPENHIM_CLIENT_ID=admin-portal
OPENHIM_CLIENT_KEY_PATH=/run/secrets/admin-portal.key.pem
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/openhie/protocol/openid-connect/token
# KEYCLOAK_ISSUER from the single_stack .env, exactly as in the tokens.
KEYCLOAK_ISSUER=http://localhost:8083/realms/openhie
UPSTREAM_TIMEOUT_MS=60000

# Admin sign-in (DEV ONLY — a single shared credential pair).
# Before production: replace with Keycloak (an `admin-portal` client + real users, so
# each merge is attributed to a named person and can be revoked individually).
ADMIN_USERNAME=admin@mohp.gov.np
ADMIN_PASSWORD=change-me-please
SESSION_JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=3600
